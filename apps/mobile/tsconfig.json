{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "rootDir": "../..",
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../../supabase/functions/_shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../supabase/functions/_shared/*.ts"
  ],
  "exclude": ["../../supabase/functions/_shared/server.ts"]
}