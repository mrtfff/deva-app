{
  "name": "@deva/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc -b",
    "prebuild:android": "expo prebuild --platform android",
    "apk:build": "npm run apk:clean && cd android && ./gradlew assembleRelease",
    "apk:clean": "node scripts/clear-metro-cache.mjs && node -e \"const{rmSync}=require('fs');for(const p of ['android/app/build/generated/assets','android/app/build/intermediates/assets'])rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-constants": "58.0.15",
    "expo-linking": "57.0.11",
    "expo-location": "57.0.20",
    "expo-maps": "57.0.3",
    "expo-notifications": "57.0.21",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.0",
    "jest": "30.2.0",
    "jest-expo": "57.0.5",
    "typescript": "5.9.3",
    "@expo/config-plugins": "57.0.9"
  }
}
