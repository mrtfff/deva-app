{
  "name": "deva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "version:check": "node scripts/check-version.mjs",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:import": "npm run db:import --workspace @deva/db --",
    "db:testuser": "npm run db:testuser --workspace @deva/db",
    "fn:serve": "supabase functions serve --env-file supabase/functions/.env",
    "mobile": "npm run start --workspace @deva/mobile",
    "apk:build": "npm run apk:build --workspace @deva/mobile",
    "prebuild:android": "npm run prebuild:android --workspace @deva/mobile",
    "device": "node scripts/device.mjs",
    "device:env": "node scripts/device.mjs env",
    "device:apk": "node scripts/device.mjs apk",
    "device:expo": "node scripts/device.mjs expo",
    "device:watch": "node scripts/device.mjs watch",
    "device:stop": "node scripts/device.mjs stop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "qrcode": "^1.5.4",
    "supabase": "2.119.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
